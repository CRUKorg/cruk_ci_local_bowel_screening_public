hoverlabel = list(font = list(family = 'Poppins', size = 14)),
textposition = "none",
legendgroup = ~signif_change,
name = 'Selected practice area') %>%
add_annotations(data = chosenGPData,
x = ~Id,
yref = "paper",
y = -0.02,
ax = 0,
ay = 5,
arrowhead = 1,
text = "")
